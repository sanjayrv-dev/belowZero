{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://belowzero/contracts/v1/activation-envelope.schema.json",
  "title": "UI activation envelope v1",
  "description": "docs/02_SYSTEM_ARCHITECTURE.md, 'UI activation envelope'. Implemented in SSDShredder.UI.Activation.ActivationEnvelope (C#) and SSDShredder.ShellExtension's Common/ActivationEnvelope.{h,cpp} (native). Separate from a worker request: an accepted activation grants no mutation authority.",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "id", "action", "source", "paths"],
  "properties": {
    "v": { "const": 1 },
    "id": { "type": "string", "format": "uuid" },
    "action": { "enum": ["open", "select"] },
    "source": { "enum": ["desktop", "explorer", "terminal"] },
    "paths": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "action": { "const": "open" } } },
      "then": { "properties": { "paths": { "maxItems": 0 } } }
    },
    {
      "if": { "properties": { "action": { "const": "select" } } },
      "then": { "properties": { "paths": { "minItems": 1, "maxItems": 1 } } }
    }
  ]
}
